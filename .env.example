# AgentPOS for Alexa+ (bridge). Copy to .env; never commit .env.

# Store the bridge sits in front of (any AgentPOS store). Default: the public demo store.
AGENTPOS_STORE_URL=https://demo.agentposhq.com

# Bearer token Alexa+ (or the simulator) presents to the bridge's MCP and checkout endpoints.
BRIDGE_BEARER_TOKEN=change-me

# Stellar network the store settles on. testnet by default; pubnet only with founder confirmation.
STELLAR_NETWORK=testnet
# Set to "true" only for the authorized mainnet demo recording.
ALLOW_MAINNET=false

# Amazon payment handlers run against a simulated PSP while the Alexa+ program is in preview.
AMAZON_PSP_MODE=simulated

# AWS (agents and simulator). Region is us-east-1 for Bedrock and AgentCore.
AWS_REGION=us-east-1
BEDROCK_MODEL_FAST=amazon.nova-2-lite-v1:0
BEDROCK_MODEL_STRONG=anthropic.claude-sonnet-4-5-20250929-v1:0
AGENTCORE_RUNTIME_ARN=

# Simulator buyer mandate (created with `npx @agentpos/mcp-buyer init`). Passphrase via env only.
AGENTPOS_BUYER_PROFILE=default
AGENTPOS_BUYER_PASSPHRASE=

# Local storage (node:sqlite).
BRIDGE_DB_PATH=./.data/bridge.sqlite
