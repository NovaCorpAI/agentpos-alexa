# AgentPOS for Alexa+ (bridge). Copy to .env; never commit .env.

# First Store registered at boot (the Bridge is multi-tenant; more Stores register through the
# Merchant console). Default: the public demo store, which settles on Stellar mainnet.
AGENTPOS_STORE_URL=https://demo.agentposhq.com

# Runtime of the agents and the Household memory: "local" (in-process, SQLite) or "agentcore".
# Without AWS credentials the Scenes run in Recorded mode.
AGENT_RUNTIME=local

# Bearer token Alexa+ (or the simulator) presents to the bridge's MCP and checkout endpoints.
BRIDGE_BEARER_TOKEN=change-me

# Payment rails. The merchant chooses; the bridge never holds a PSP key.
# Merchant PSP: the UCP processor tokenizer handler with Stripe (test mode) as processor. The charge
# is executed by the store behind its PaymentRail. The Stripe key
# lives in the store (WooCommerce), never here. This only enables the handler in the profile.
MERCHANT_PSP_HANDLER=dev.ucp.processor_tokenizer
# Amazon payment handlers run against a simulated PSP while the Alexa+ program is in preview.
AMAZON_PSP_MODE=simulated

# Stellar network the store settles on (x402 rail). testnet by default; pubnet only with founder confirmation.
STELLAR_NETWORK=testnet
# Set to "true" only for the authorized mainnet demo recording.
ALLOW_MAINNET=false

# AWS (agents and simulator). Region is us-east-1 for Bedrock and AgentCore.
AWS_REGION=us-east-1
BEDROCK_MODEL_FAST=amazon.nova-2-lite-v1:0
BEDROCK_MODEL_STRONG=anthropic.claude-sonnet-4-5-20250929-v1:0
AGENTCORE_RUNTIME_ARN=

# Simulator buyer mandate (created with `npx @agentpos/mcp-buyer init`). Passphrase via env only.
AGENTPOS_BUYER_PROFILE=default
AGENTPOS_BUYER_PASSPHRASE=

# Local storage (node:sqlite). Schema of usage_events in docs/USAGE-EVENTS.md.
BRIDGE_DB_PATH=./.data/bridge.sqlite
# Port the bridge listens on.
PORT=8787
