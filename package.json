{
  "name": "agentpos-alexa",
  "version": "0.0.1",
  "private": true,
  "description": "Alexa+ add-on for AgentPOS stores: MCP server, UCP checkout, payment rails, merchant agents and a simulated Alexa+ client.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev:bridge": "pnpm --filter @agentpos-alexa/bridge dev",
    "dev:fixture-store": "pnpm --filter @agentpos-alexa/fixture-store dev",
    "dev:simulator": "pnpm --filter @agentpos-alexa/simulator dev",
    "bedrock:check": "node scripts/bedrock-check.mjs",
    "deploy:aws": "node scripts/deploy-aws.mjs",
    "domain:setup": "node scripts/custom-domain.mjs",
    "demo:run": "node scripts/demo-run.mjs",
    "video:narration": "node scripts/video-narration.mjs",
    "video:record": "node scripts/video-record.mjs",
    "video:build": "node scripts/video-build.mjs",
    "submission:bundle": "node scripts/submission-bundle.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-acm": "^3.1135.0",
    "@aws-sdk/client-apprunner": "^3.1133.0",
    "@aws-sdk/client-bedrock": "^3.1132.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1133.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1132.0",
    "@aws-sdk/client-codebuild": "^3.1133.0",
    "@aws-sdk/client-ecr": "^3.1133.0",
    "@aws-sdk/client-ecs": "^3.1133.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1135.0",
    "@aws-sdk/client-iam": "^3.1133.0",
    "@aws-sdk/client-polly": "^3.1133.0",
    "@aws-sdk/client-sts": "^3.1133.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
